{
  "name": "ebrowser",
  "version": "1.0.1",
  "description": "An Electron application with React and TypeScript",
  "main": "./out/main/index.js",
  "author": "example.com",
  "homepage": "https://electron-vite.org",
  "repository": {
    "type": "git",
    "url": "https://github.com/liyao1520/electron-browser.git"
  },
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "build:ipc": "pnpm --filter @electron-browser/typed-ipc build",
    "test:ipc": "pnpm --filter @electron-browser/typed-ipc test && node --test tests/ipc.test.mjs",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run build:ipc && npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "npm run build:ipc && electron-vite dev",
    "dev:update": "npm run build:ipc && electron-vite dev -- --test-updates",
    "update:serve": "node scripts/update-server.mjs",
    "test:update": "npm run build && electron tests/updater.electron.cjs",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "install-electron && electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@material-symbols/svg-400": "^0.48.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-updater": "6.8.11",
    "lucide-react": "^1.59.0",
    "radix-ui": "^1.8.1",
    "simple-icons": "^16.35.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@electron-browser/typed-ipc": "workspace:*",
    "@electron-toolkit/eslint-config-prettier": "^3.0.1",
    "@electron-toolkit/eslint-config-ts": "^4.0.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "prettier": "^3.9.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vite-plugin-svgr": "^5.2.0"
  }
}
